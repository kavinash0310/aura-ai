# Copy to .env and replace each placeholder with a unique random value.
# Keep .env untracked. Never use these example values in deployment.
AURA_DB_NAME=aura
AURA_DB_USER=aura_dev
AURA_DB_PASSWORD=replace-with-a-unique-random-db-password
AURA_AUTH_USERNAME=aura_dev
AURA_AUTH_PASSWORD=replace-with-24-or-more-random-characters
