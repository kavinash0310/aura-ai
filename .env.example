# Copy to .env and replace each placeholder with a unique random value.
# Keep .env untracked. Never use these example values in deployment.
AURA_DB_NAME=aura
AURA_DB_USER=aura_dev
AURA_DB_PASSWORD=replace-with-a-unique-random-db-password
AURA_AUTH_USERNAME=aura_dev
AURA_AUTH_PASSWORD=replace-with-24-or-more-random-characters
AURA_AI_INTERNAL_TOKEN=replace-with-a-separate-24-or-more-random-secret
# Exact local UI origins allowed to call the API from a browser. Do not use '*'.
AURA_ALLOWED_BROWSER_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# Optional local-only report generation. Keep disabled until Ollama is installed and a model is available.
AURA_AI_MODEL_PROVIDER=disabled
AURA_AI_OLLAMA_BASE_URL=http://host.docker.internal:11434
AURA_AI_OLLAMA_MODEL=
AURA_AI_OLLAMA_TIMEOUT_SECONDS=90

# Optional. Brave provides web, news, and discussion search; account access and billing are external.
AURA_BRAVE_API_KEY=

# Public GDELT news search is enabled by default and needs no API key. Set false to disable it.
AURA_GDELT_ENABLED=true

# Public Bluesky post search uses the official public API and needs no account credentials.
# Set false to disable it; All configured sources sends each query to every enabled provider.
AURA_BLUESKY_ENABLED=true

# Optional OpenAlex scholarly-work search. Requests run only when OpenAlex or All configured sources is selected.
# Supply your own API key; it is sent in an Authorization header, never in the URL. Provider quotas or charges may apply.
AURA_OPENALEX_API_KEY=

# Optional. An NVD API key may raise the provider's request allowance; exact CVE lookups work without one.
AURA_NVD_API_KEY=

